  "highlights": [
    {
      "title": "pnpm workspace Monorepo 管理 10+ 子应用",
      "scope": "infra",
      "summary": "使用 pnpm workspace 统一管理 10 个子应用 + 4 个公共包，通过 workspace 协议实现本地依赖链接，preinstall 钩子强制统一包管理器"
    },
    {
      "title": "微前端架构：Nginx 路由分发 + 基座管理",
      "scope": "frontend",
      "summary": "基座(React) 负责全局导航与权限，子应用独立构建部署，Nginx try_files 实现 SPA 路由 fallback，各子应用通过路径隔离"
    },
    {
      "title": "Vue 3 + React 双框架共存方案",
      "scope": "frontend",
      "summary": "同一 Monorepo 下 Vue 3 和 React 17 并行开发，通过 ESLint overrides 分层配置、TDesign 统一设计系统、框架无关的公共包实现一致性"
    },
    {
      "title": "OrangeCI 增量构建 + Docker 容器化部署",
      "scope": "infra",
      "summary": "CI 通过 ifModify 按文件变更范围触发对应子应用构建，Docker 缓存 node_modules 加速构建，Nginx Alpine 轻量镜像部署"
    },
    {
      "title": "全链路工程化体系",
      "scope": "infra",
      "summary": "ESLint + Prettier + CommitLint + Husky + lint-staged + ls-lint + cspell 从代码编写到提交的全链路规范，TypeScript strict mode 保障类型安全"
    }
  ]
